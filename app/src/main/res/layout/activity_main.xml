<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#F5F5F5">

    <!-- Header Section -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#2C3E50"
        android:gravity="center"
        android:paddingBottom="8dp" />

    <!-- Status Text -->
    <TextView
        android:id="@+id/statusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Monitoring Air Quality..."
        android:textSize="16sp"
        android:textColor="#34495E"
        android:gravity="center"
        android:padding="12dp"
        android:background="@android:color/white"
        android:layout_marginBottom="8dp"
        android:elevation="2dp" />

    <!-- BLE Debug Status -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#E3F2FD"
        android:padding="8dp"
        android:layout_marginBottom="16dp"
        android:elevation="1dp">

        <TextView
            android:id="@+id/bleConnectionStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="BLE: Disconnected"
            android:textSize="12sp"
            android:textColor="#1976D2"
            android:textStyle="bold"
            android:gravity="center" />

        <TextView
            android:id="@+id/lastDataReceived"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Last data: Never"
            android:textSize="11sp"
            android:textColor="#1976D2"
            android:gravity="center"
            android:layout_marginTop="4dp" />
    </LinearLayout>

    <!-- Data Display Container (always visible) -->
    <ScrollView
        android:id="@+id/dataContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Particulate Matter Section -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/particulate_matter"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#2C3E50"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:background="#E8F4F8" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@android:color/white"
                android:padding="16dp"
                android:elevation="2dp"
                android:layout_marginBottom="8dp">

                <TextView
                    android:id="@+id/pm10Text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="PM10: -- µg/m³"
                    android:textSize="16sp"
                    android:textColor="#34495E"
                    android:paddingVertical="4dp" />

                <TextView
                    android:id="@+id/pm25Text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="PM2.5: -- µg/m³"
                    android:textSize="16sp"
                    android:textColor="#34495E"
                    android:paddingVertical="4dp" />

                <TextView
                    android:id="@+id/pm1Text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="PM1.0: -- µg/m³"
                    android:textSize="16sp"
                    android:textColor="#34495E"
                    android:paddingVertical="4dp" />

                <TextView
                    android:id="@+id/obstructedText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Sensor Status: --"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:paddingTop="8dp" />
            </LinearLayout>

            <!-- Environmental Data Section -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/environmental_data"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#2C3E50"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:background="#E8F8E8" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@android:color/white"
                android:padding="16dp"
                android:elevation="2dp"
                android:layout_marginBottom="8dp">

                <TextView
                    android:id="@+id/temperatureText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Temperature: -- °C"
                    android:textSize="16sp"
                    android:textColor="#34495E"
                    android:paddingVertical="4dp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/humidityText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Humidity: -- %"
                    android:textSize="16sp"
                    android:textColor="#34495E"
                    android:paddingVertical="4dp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/pressureText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Pressure: -- hPa"
                    android:textSize="16sp"
                    android:textColor="#34495E"
                    android:paddingVertical="4dp"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Air Quality Index Section -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/air_quality_index"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#2C3E50"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:background="#FFF4E8" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@android:color/white"
                android:padding="16dp"
                android:elevation="2dp"
                android:layout_marginBottom="8dp">

                <TextView
                    android:id="@+id/iaqText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="IAQ: --"
                    android:textSize="16sp"
                    android:textColor="#34495E"
                    android:paddingVertical="4dp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/iaqAccuracyText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="IAQ Accuracy: --"
                    android:textSize="14sp"
                    android:textColor="#7F8C8D"
                    android:paddingVertical="4dp" />

                <TextView
                    android:id="@+id/gasResistanceText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Gas Resistance: -- Ω"
                    android:textSize="16sp"
                    android:textColor="#34495E"
                    android:paddingVertical="4dp"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Chart Controls Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@android:color/white"
                android:padding="12dp"
                android:elevation="2dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Time Range:"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#2C3E50"
                    android:layout_marginEnd="12dp" />

                <Button
                    android:id="@+id/lastHourButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Last Hour"
                    android:textSize="12sp"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="8dp"
                    style="?attr/materialButtonOutlinedStyle" />

                <Button
                    android:id="@+id/allDataButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="All Data"
                    android:textSize="12sp"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="8dp"
                    android:layout_marginStart="8dp"
                    style="?attr/materialButtonOutlinedStyle" />

            </LinearLayout>

            <!-- Gas Profile Section -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/gas_profile"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#2C3E50"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:background="#F8E8F8" />

            <!-- Gas Resistance Bar Chart -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@android:color/white"
                android:padding="16dp"
                android:elevation="2dp"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Gas Resistance by Temperature"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#2C3E50"
                    android:paddingBottom="8dp" />

                <com.patrykandpatrick.vico.views.cartesian.CartesianChartView
                    android:id="@+id/gasResistanceChart"
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    app:layers="column"
                    app:showStartAxis="true"
                    app:showBottomAxis="true" />

            </LinearLayout>

            <!-- Particle Matter History Chart -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Particle Matter History"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#2C3E50"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:background="#E8F4F8" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@android:color/white"
                android:padding="16dp"
                android:elevation="2dp"
                android:layout_marginBottom="8dp">

                <com.patrykandpatrick.vico.views.cartesian.CartesianChartView
                    android:id="@+id/particleMatterChart"
                    android:layout_width="match_parent"
                    android:layout_height="250dp"
                    app:layers="line"
                    app:showStartAxis="true"
                    app:showBottomAxis="true" />

            </LinearLayout>

            <!-- Temperature & Humidity History Chart -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Temperature &amp; Humidity History"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#2C3E50"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:background="#E8F8E8" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@android:color/white"
                android:padding="16dp"
                android:elevation="2dp"
                android:layout_marginBottom="8dp">

                <com.patrykandpatrick.vico.views.cartesian.CartesianChartView
                    android:id="@+id/tempHumidityChart"
                    android:layout_width="match_parent"
                    android:layout_height="250dp"
                    app:layers="line"
                    app:showStartAxis="true"
                    app:showBottomAxis="true" />

            </LinearLayout>

            <!-- Timestamp -->
            <TextView
                android:id="@+id/timestampText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Last Update: --"
                android:textSize="12sp"
                android:textColor="#95A5A6"
                android:gravity="center"
                android:paddingTop="8dp"
                android:paddingBottom="16dp" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>
